NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The public template catalog uses only the URL and anon key through the server data layer.
# It never uses the service role key.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Keep false until the digital migration and RLS checks have been applied.
LEAD_SUBMISSIONS_ENABLED=false
# Exact website origins; no wildcards. Configure production domains separately.
LEAD_ALLOWED_ORIGINS=http://localhost:3001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
